+/* MISHARE_RESET_CONTEXT_BEGIN:release */
+int mishare_ndi_reset_context_check(struct wlan_objmgr_vdev *vdev,
+                                   unsigned long dp_cookie)
+{
+ tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+ struct wlan_objmgr_psoc *psoc;
+ struct vdev_mlme_obj *m;
+ struct wma_txrx_node *iface;
+ struct wlan_objmgr_peer *peer;
+ void *soc = cds_get_context(QDF_MODULE_ID_SOC);
+ uint8_t id, *mac;
+ uint16_t peers;
+ bool same;
+
+ if (!vdev || !wma || !dp_cookie || !cds_is_driver_recovering() ||
+     wmi_validate_handle(wma->wmi_handle) || !wmi_is_blocked(wma->wmi_handle))
+  return -EUCLEAN;
+ psoc = wlan_vdev_get_psoc(vdev);
+ m = wlan_vdev_mlme_get_cmpt_obj(vdev);
+ id = wlan_vdev_get_id(vdev);
+ if (!psoc || wma->psoc != psoc || id >= wma->max_bssid ||
+     !soc || (unsigned long)soc != dp_cookie ||
+     wlan_psoc_get_dp_handle(psoc) != soc ||
+     !m || m->vdev != vdev || !m->ext_vdev_ptr ||
+     !wma_mishare_pas_ndi(vdev, m->mgmt.generic.type) ||
+     m->mgmt.generic.subtype ||
+     wlan_vdev_mlme_get_state(vdev) != WLAN_VDEV_S_INIT)
+  return -EUCLEAN;
+ iface = &wma->interfaces[id];
+ if (iface->vdev != vdev || !iface->vdev_active ||
+     !wma_mishare_pas_ndi(vdev, iface->type) || iface->sub_type ||
+     iface->peer_count != 1 || iface->del_staself_req || iface->is_del_sta_deferred ||
+     qdf_atomic_read(&iface->bss_status) != WMA_BSS_STATUS_STOPPED)
+  return -EUCLEAN;
+ wlan_vdev_obj_lock(vdev);
+ peers = wlan_vdev_get_peer_count(vdev);
+ wlan_vdev_obj_unlock(vdev);
+ if (peers != 1)
+  return -EUCLEAN;
+ /* no_fw alone may take an asynchronous unmap-confirm path. Only the
+  * native force-detach branch without WMI confirmation is admitted here. */
+ if (!is_cdp_peer_detach_force_delete_supported(soc) ||
+     cdp_cfg_get_peer_unmap_conf_support(soc))
+  return -EOPNOTSUPP;
+ mac = wlan_vdev_mlme_get_macaddr(vdev);
+ peer = wlan_objmgr_get_peer_by_mac(psoc, mac, WLAN_LEGACY_WMA_ID);
+ if (!peer)
+  return -EUCLEAN;
+ same = wlan_peer_get_vdev(peer) == vdev;
+ wlan_objmgr_peer_release_ref(peer, WLAN_LEGACY_WMA_ID);
+ if (!same)
+  return -EUCLEAN;
+ return 0;
+}
+
+int mishare_ndi_reset_context_release(struct wlan_objmgr_vdev *vdev,
+                                     unsigned long dp_cookie,
+                                     struct mishare_ndi_reset_context_result *result)
+{
+ tp_wma_handle wma;
+ struct vdev_mlme_obj *m;
+ struct wma_txrx_node *iface;
+ struct wlan_objmgr_psoc *psoc;
+ struct wlan_objmgr_peer *peer;
+ uint8_t id, *mac;
+ uint16_t peers;
+ int ret;
+ if (!result)
+  return -EINVAL;
+ qdf_mem_zero(result, sizeof(*result));
+ ret = mishare_ndi_reset_context_check(vdev, dp_cookie);
+ if (ret)
+  return ret;
+ wma = cds_get_context(QDF_MODULE_ID_WMA);
+ psoc = wlan_vdev_get_psoc(vdev);
+ m = wlan_vdev_mlme_get_cmpt_obj(vdev);
+ id = wlan_vdev_get_id(vdev);
+ mac = wlan_vdev_mlme_get_macaddr(vdev);
+ iface = &wma->interfaces[id];
+ ret = qdf_status_to_os_return(wma_remove_peer(wma, mac, id, true));
+ if (ret || iface->peer_count)
+  return ret ? ret : -EUCLEAN;
+ peer = wlan_objmgr_get_peer_by_mac(psoc, mac, WLAN_LEGACY_WMA_ID);
+ if (peer) {
+  wlan_objmgr_peer_release_ref(peer, WLAN_LEGACY_WMA_ID);
+  return -EUCLEAN;
+ }
+ /* Logical peer delete is observed, not physical final-free. The DP and
+  * object-manager VDEV final-free callbacks still gate host retirement. */
+ result->peer_released = true;
+ /* Component destructors run at physical peer destruction, not logical
+  * delete. A delayed peer remains on the VDEV list: retain its context. */
+ wlan_vdev_obj_lock(vdev);
+ peers = wlan_vdev_get_peer_count(vdev);
+ wlan_vdev_obj_unlock(vdev);
+ if (peers)
+  return -EUCLEAN;
+ ret = mishare_ndi_wma_unbind(vdev);
+ if (ret)
+  return ret;
+ result->wma_unbound = true;
+ ret = mishare_ndi_legacy_release(m);
+ if (ret)
+  return ret;
+ result->legacy_released = true;
+ return 0;
+}
+/* MISHARE_RESET_CONTEXT_END:release */
