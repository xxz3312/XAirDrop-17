diff --git a/qcacld-3.0/core/wma/inc/wma_mishare_ndi.h b/qcacld-3.0/core/wma/inc/wma_mishare_ndi.h
new file mode 100644
--- /dev/null
+++ b/qcacld-3.0/core/wma/inc/wma_mishare_ndi.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* PAS host / NDI firmware compatibility, adapted from OPAirDrop SM8750.
+ * Xiaomi 15 selects this route; target firmware acceptance is unverified.
+ * No mode selection, CREATE, lifecycle ownership or module parameter here.
+ */
+#ifndef WMA_MISHARE_NDI_H
+#define WMA_MISHARE_NDI_H
+#include "wlan_objmgr_vdev_obj.h"
+#include "wmi_unified.h"
+#include "wlan_mlme_vdev_mgr_interface.h"
+
+static inline bool
+wma_mishare_pas_ndi(struct wlan_objmgr_vdev *vdev, uint32_t type)
+{
+	return vdev && type == WMI_VDEV_TYPE_NDI &&
+	       wlan_vdev_mlme_get_opmode(vdev) == QDF_PASSTHRU_MODE;
+}
+
+/* Use the SAME predicate for peer create, delete and sync-delete waiting.
+ * Native NDI and every legacy self-peer decision remain unchanged.
+ */
+static inline bool
+wma_mishare_uses_self_peer(struct wlan_objmgr_vdev *vdev,
+			   uint32_t type, uint32_t subtype)
+{
+	return mlme_vdev_uses_self_peer(type, subtype) ||
+	       wma_mishare_pas_ndi(vdev, type);
+}
+#endif
