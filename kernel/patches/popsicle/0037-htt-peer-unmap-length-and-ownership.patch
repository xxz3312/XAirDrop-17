+/*
+ * Consume peer-unmap indications before the generic dispatcher reads fields.
+ * Return false only for a successful, header-sized non-unmap indication: its
+ * nbuf remains owned by the existing dispatcher. All consumed indications are
+ * freed exactly once here, including transport errors and short messages.
+ * V2 needs the prefix through PEER_WDS_FREE_COUNT; unused trailing fields are
+ * deliberately not required for compatibility with the previous consumer.
+ */
+static bool dp_htt_t2h_peer_unmap_try_handle(void *context, HTC_PACKET *pkt)
+{
+	struct htt_soc *soc = context;
+	qdf_nbuf_t msg;
+	u_int32_t words[HTT_RX_PEER_UNMAP_V2_BYTES / sizeof(u_int32_t)] = {0};
+	u_int32_t required, free_wds_count = DP_PEER_WDS_COUNT_INVALID;
+	enum htt_t2h_msg_type type;
+	u_int16_t peer_id;
+	u_int8_t vdev_id, is_wds = 0;
+	u_int8_t mac_buffer[QDF_MAC_ADDR_SIZE] = {0};
+	u_int8_t *mac = mac_buffer;
+
+	if (!pkt)
+		return true;
+	msg = (qdf_nbuf_t)pkt->pPktContext;
+	if (!soc || !msg) {
+		if (msg)
+			dp_htt_rx_nbuf_free(msg);
+		return true;
+	}
+	if (pkt->Status != QDF_STATUS_SUCCESS) {
+		if (pkt->Status != QDF_STATUS_E_CANCELED)
+			soc->stats.htc_err_cnt++;
+		dp_htt_rx_nbuf_free(msg);
+		return true;
+	}
+	if (qdf_nbuf_len(msg) < sizeof(words[0]) || !qdf_nbuf_data(msg)) {
+		dp_htt_err("short or absent HTT indication header");
+		dp_htt_rx_nbuf_free(msg);
+		return true;
+	}
+	qdf_mem_copy(words, qdf_nbuf_data(msg), sizeof(words[0]));
+	type = HTT_T2H_MSG_TYPE_GET(words[0]);
+	if (type != HTT_T2H_MSG_TYPE_PEER_UNMAP &&
+	    type != HTT_T2H_MSG_TYPE_PEER_UNMAP_V2)
+		return false;
+
+	required = type == HTT_T2H_MSG_TYPE_PEER_UNMAP ?
+		HTT_RX_PEER_UNMAP_BYTES :
+		HTT_RX_PEER_UNMAP_V2_PEER_WDS_FREE_COUNT_OFFSET + sizeof(words[0]);
+	if (qdf_nbuf_len(msg) < required) {
+		dp_htt_err("short peer unmap type %u len %u need %u", type,
+			   qdf_nbuf_len(msg), required);
+		dp_htt_rx_nbuf_free(msg);
+		return true;
+	}
+	qdf_mem_copy(words, qdf_nbuf_data(msg), required);
+	if (type == HTT_T2H_MSG_TYPE_PEER_UNMAP) {
+		peer_id = HTT_RX_PEER_UNMAP_PEER_ID_GET(words[0]);
+		vdev_id = HTT_RX_PEER_UNMAP_VDEV_ID_GET(words[0]);
+	} else {
+		peer_id = HTT_RX_PEER_UNMAP_V2_SW_PEER_ID_GET(words[0]);
+		vdev_id = HTT_RX_PEER_UNMAP_V2_VDEV_ID_GET(words[0]);
+		mac = htt_t2h_mac_addr_deswizzle((u_int8_t *)(words + 1),
+					       mac_buffer);
+		is_wds = HTT_RX_PEER_UNMAP_V2_NEXT_HOP_GET(words[2]);
+		free_wds_count =
+			HTT_RX_PEER_UNMAP_V2_PEER_WDS_FREE_COUNT_GET(words[4]);
+	}
+	htt_event_record(soc->htt_logger_handle, type, qdf_nbuf_data(msg));
+	dp_rx_peer_unmap_handler(soc->dp_soc, peer_id, vdev_id, mac,
+				 is_wds, free_wds_count);
+	dp_htt_rx_nbuf_free(msg);
+	return true;
+}
