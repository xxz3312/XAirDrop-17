+/* MISHARE_BEGIN:start_plan_builder */
+#include <linux/errno.h>
+#include <wmi_unified_param.h>
+/* Read the target's own START encoder inputs. No target-if call, timer or WMI.
+ * Caller has validated the PE/owner identity on MC and holds parent exclusion.
+ * The resulting summary is evidence of preparation, never a reusable command.
+ */
+int mishare_ndi_start_plan_build(struct vdev_mlme_obj *mlme, uint32_t freq,
+                               struct mishare_ndi_start_summary *summary)
+{
+#ifdef MOBILE_DFS_SUPPORT
+	struct vdev_start_params params = {0};
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_channel *des;
+	uint8_t nss;
+	QDF_STATUS status;
+
+	if (!mlme || !summary || !mlme->vdev || !mlme->ext_vdev_ptr)
+		return -EINVAL;
+	vdev = mlme->vdev;
+	des = wlan_vdev_mlme_get_des_chan(vdev);
+	if (wlan_vdev_mlme_get_opmode(vdev) != QDF_PASSTHRU_MODE ||
+	    mlme->mgmt.generic.type != WLAN_VDEV_MLME_TYPE_NDI ||
+	    mlme->mgmt.generic.subtype ||
+	    wlan_vdev_mlme_get_state(vdev) != WLAN_VDEV_S_INIT || !des ||
+	    des->ch_width != CH_WIDTH_20MHZ || des->ch_freq != freq ||
+	    des->ch_cfreq1 != freq || des->ch_cfreq2)
+		return -EUCLEAN;
+	if (!wlan_reg_is_24ghz_ch_freq(freq) && !wlan_reg_is_5ghz_ch_freq(freq))
+		return -EINVAL;
+	nss = wlan_reg_is_24ghz_ch_freq(freq) ? mlme->proto.generic.nss_2g :
+						 mlme->proto.generic.nss_5g;
+	if (!nss || nss > 2 || !mlme->proto.ht_info.allow_ht ||
+	    mlme->proto.vht_info.allow_vht ||
+	    mlme->mgmt.rate_info.half_rate || mlme->mgmt.rate_info.quarter_rate ||
+	    mlme->mgmt.generic.phy_mode != (wlan_reg_is_24ghz_ch_freq(freq) ?
+			WMI_HOST_MODE_11NG_HT20 : WMI_HOST_MODE_11NA_HT20))
+		return -EUCLEAN;
+	/* With MOBILE_DFS_SUPPORT the native AP-only predicate excludes PAS.
+	 * The non-mobile fallback returns true for all modes and can mutate DFS
+	 * state. Do not silently reuse that variant as a host-only preparation.
+	 */
+	status = vdev_mgr_start_param_update(mlme, &params);
+	if (QDF_IS_STATUS_ERROR(status))
+		return -EUCLEAN;
+	if (params.vdev_id != wlan_vdev_get_id(vdev) || params.is_restart ||
+	    params.channel.mhz != freq || params.channel.cfreq1 != freq ||
+	    params.channel.cfreq2 || params.channel.dfs_set ||
+	    params.channel.is_chan_passive || !params.channel.allow_ht ||
+	    params.channel.allow_vht || params.channel.half_rate ||
+	    params.channel.quarter_rate || params.channel.phy_mode !=
+						 mlme->mgmt.generic.phy_mode ||
+	    params.preferred_tx_streams != nss || params.preferred_rx_streams != nss ||
+	    params.ssid.length ||
+	    params.channel.regpower != mlme->mgmt.generic.maxregpower)
+		return -EUCLEAN;
+#ifdef WLAN_FEATURE_11BE_MLO
+	if (params.mlo_flags.mlo_enabled)
+		return -EUCLEAN;
+#endif
+	summary->freq = params.channel.mhz;
+	summary->center_freq = params.channel.cfreq1;
+	summary->phy_mode = params.channel.phy_mode;
+	summary->tx_streams = params.preferred_tx_streams;
+	summary->rx_streams = params.preferred_rx_streams;
+	summary->beacon_interval = params.beacon_interval;
+	summary->dtim_period = params.dtim_period;
+	return 0;
+#else
+	(void)mlme;
+	(void)freq;
+	(void)summary;
+	return -EOPNOTSUPP;
+#endif
+}
+/* MISHARE_END:start_plan_builder */
