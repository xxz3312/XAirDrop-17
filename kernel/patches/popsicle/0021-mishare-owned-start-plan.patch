@@ -7705,3 +7705,40 @@
 	return qdf_status_to_os_return(wma_remove_peer(wma, mac, id, false));
 }
 /* MISHARE_END:wma_helpers */
+
+/* MISHARE_BEGIN:start_plan_wma */
+/* Validate the already owned DEFAULT self-peer. Ordinary pre-start setup
+ * creates another peer; never call it for this PAS resource owner.
+ */
+int mishare_ndi_start_plan_wma_check(struct wlan_objmgr_vdev *vdev)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wma_txrx_node *iface;
+	struct wlan_objmgr_peer *peer;
+	uint8_t id;
+	bool same;
+
+	if (!wma || !vdev || wma->psoc != wlan_vdev_get_psoc(vdev))
+		return -EUCLEAN;
+	id = wlan_vdev_get_id(vdev);
+	if (id >= wma->max_bssid)
+		return -EUCLEAN;
+	iface = &wma->interfaces[id];
+	if (iface->vdev != vdev || !wma_mishare_pas_ndi(vdev, iface->type) ||
+	    iface->sub_type || !iface->vdev_active || iface->peer_count != 1 ||
+	    iface->del_staself_req || iface->is_del_sta_deferred ||
+	    qdf_atomic_read(&iface->bss_status) != WMA_BSS_STATUS_STOPPED)
+		return -EUCLEAN;
+	if (!wmi_service_enabled(wma->wmi_handle, wmi_service_nan_data) ||
+	    !wmi_service_enabled(wma->wmi_handle, wmi_service_sync_delete_cmds))
+		return -EOPNOTSUPP;
+	peer = wlan_objmgr_get_peer_by_mac(wma->psoc,
+			 wlan_vdev_mlme_get_macaddr(vdev), WLAN_LEGACY_WMA_ID);
+	if (!peer)
+		return -EUCLEAN;
+	same = wlan_peer_get_vdev(peer) == vdev &&
+	       wlan_peer_get_peer_type(peer) == WLAN_PEER_SELF;
+	wlan_objmgr_peer_release_ref(peer, WLAN_LEGACY_WMA_ID);
+	return same ? 0 : -EUCLEAN;
+}
+/* MISHARE_END:start_plan_wma */
--- a/qcacld-3.0/core/mac/src/pe/lim/lim_api.c
+++ b/qcacld-3.0/core/mac/src/pe/lim/lim_api.c
@@ -5520,3 +5520,99 @@
 	return 0;
 }
 /* MISHARE_END:channel_helpers */
+
+/* MISHARE_BEGIN:start_plan_request */
+struct mishare_start_plan_request {
+	struct mishare_channel_request channel;
+};
+
+static int mishare_start_plan_execute(struct mishare_start_plan_request *req,
+				     struct mishare_ndi_start_summary *summary)
+{
+	int ret;
+
+	ret = mishare_ndi_start_plan_wma_check(req->channel.vdev);
+	if (ret)
+		return ret;
+	/* Re-run exact PE identity, INIT, regulatory and concurrency checks on
+	 * the actual MC thread. This re-prepares host fields; it acquires no
+	 * regulatory lease and never calls the monitor switch/WMI path.
+	 */
+	ret = mishare_channel_execute(&req->channel);
+	if (ret)
+		return ret;
+	return mishare_ndi_start_plan_build(
+		wlan_vdev_mlme_get_cmpt_obj(req->channel.vdev), req->channel.freq,
+		summary);
+}
+
+static QDF_STATUS mishare_start_plan_finish(struct scheduler_msg *msg, bool flushed)
+{
+	struct mishare_start_plan_request *req = msg->bodyptr;
+	struct mishare_ndi_start_summary summary = {0};
+	struct wlan_objmgr_psoc *psoc;
+	void *owner;
+	uint32_t freq;
+	uint8_t id;
+	int ret;
+
+	if (!req)
+		return QDF_STATUS_E_INVAL;
+	psoc = wlan_vdev_get_psoc(req->channel.vdev);
+	id = wlan_vdev_get_id(req->channel.vdev);
+	owner = req->channel.owner;
+	freq = req->channel.freq;
+	ret = flushed ? -ECANCELED : mishare_start_plan_execute(req, &summary);
+	wlan_objmgr_vdev_release_ref(req->channel.vdev, WLAN_LEGACY_MAC_ID);
+	qdf_mem_free(req);
+	msg->bodyptr = NULL;
+	mishare_runtime_ndi_start_plan_event(psoc, id, owner, freq, ret,
+					    ret ? NULL : &summary);
+	return QDF_STATUS_SUCCESS;
+}
+
+static QDF_STATUS mishare_start_plan_callback(struct scheduler_msg *msg)
+{
+	return mishare_start_plan_finish(msg, false);
+}
+
+static QDF_STATUS mishare_start_plan_flush(struct scheduler_msg *msg)
+{
+	return mishare_start_plan_finish(msg, true);
+}
+
+int mishare_ndi_start_plan_post(struct wlan_objmgr_vdev *vdev, void *owner,
+			      unsigned long cookie, uint32_t freq)
+{
+	struct mishare_start_plan_request *req;
+	struct scheduler_msg msg = {0};
+	QDF_STATUS status;
+
+	if (!vdev || !owner || !cookie || !freq ||
+	    wlan_vdev_mlme_get_opmode(vdev) != QDF_PASSTHRU_MODE)
+		return -EINVAL;
+	req = qdf_mem_malloc(sizeof(*req));
+	if (!req)
+		return -ENOMEM;
+	status = wlan_objmgr_vdev_try_get_ref(vdev, WLAN_LEGACY_MAC_ID);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		qdf_mem_free(req);
+		return -ENODEV;
+	}
+	req->channel.vdev = vdev;
+	req->channel.owner = owner;
+	req->channel.session_cookie = cookie;
+	req->channel.freq = freq;
+	msg.bodyptr = req;
+	msg.callback = mishare_start_plan_callback;
+	msg.flush_callback = mishare_start_plan_flush;
+	status = scheduler_post_message(QDF_MODULE_ID_HDD, QDF_MODULE_ID_PE,
+					QDF_MODULE_ID_TARGET_IF, &msg);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_MAC_ID);
+		qdf_mem_free(req);
+		return qdf_status_to_os_return(status);
+	}
+	return 0;
+}
+/* MISHARE_END:start_plan_request */
