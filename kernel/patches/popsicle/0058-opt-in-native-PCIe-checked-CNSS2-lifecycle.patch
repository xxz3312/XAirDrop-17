 static void pld_pcie_remove(struct pci_dev *pdev)
 {
+#ifdef CONFIG_MISHARE_CHECKED_CNSS2_UNREGISTER
+	struct device *dev = &pdev->dev;
+	struct pld_context *pld_context;
+	struct osif_psoc_sync *psoc_sync = NULL;
+	bool recorded;
+	int ret;
+
+	ret = opairshare_wlan_execution_remove_begin(THIS_MODULE, dev, &recorded);
+	if (ret)
+		return;
+	/* This exceptional native path has no PSOC transition proof. */
+	if (cds_is_pcie_link_resume_fail()) {
+		ret = -EBUSY;
+		goto refuse;
+	}
+	ret = osif_psoc_sync_trans_start_wait(dev, &psoc_sync);
+	if (ret)
+		goto refuse;
+	osif_psoc_sync_wait_for_ops(psoc_sync);
+	pld_context = pld_get_global_context();
+	if (!pld_context || !pld_context->ops || !pld_context->ops->remove) {
+		ret = -ENODEV;
+		goto refuse;
+	}
+	ret = hdd_mishare_remove_prepare(dev);
+	if (ret)
+		goto refuse;
+	cds_set_driver_loaded(false);
+	cds_set_unload_in_progress(true);
+	osif_psoc_sync_unregister(dev);
+	pld_context->ops->remove(dev, PLD_BUS_TYPE_PCIE);
+	pld_del_dev(pld_context, dev);
+	osif_psoc_sync_trans_stop(psoc_sync);
+	osif_psoc_sync_destroy(psoc_sync);
+	if (recorded)
+		opairshare_wlan_execution_remove_end(THIS_MODULE, dev, 0);
+	return;
+refuse:
+	if (recorded)
+		opairshare_wlan_execution_remove_end(THIS_MODULE, dev, ret);
+	/* Retain transition/lookup on refusal; no forced cleanup or replay. */
+	pr_err("MiShare: PCIe remove retained (%d)\n", ret);
+#else
+
 	struct pld_context *pld_context;
 	int errno;
 	struct osif_psoc_sync *psoc_sync = NULL;
@@ -126,6 +175,7 @@
 		osif_psoc_sync_trans_stop(psoc_sync);
 		osif_psoc_sync_destroy(psoc_sync);
 	}
+#endif
 }
 
