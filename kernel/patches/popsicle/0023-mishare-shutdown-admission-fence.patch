+/* MISHARE_SHUTDOWN_BEGIN:platform */
+#include "wlan_hdd_mishare_runtime.h"
+bool mishare_runtime_platform_available(struct wlan_objmgr_psoc *psoc)
+{
+ struct hdd_context *hdd_ctx = cds_get_context(QDF_MODULE_ID_HDD);
+ return psoc && hdd_ctx && hdd_ctx->psoc == psoc &&
+        hdd_ctx->driver_status == DRIVER_MODULES_ENABLED &&
+        !cds_is_driver_recovering() && !cds_is_driver_unloading() &&
+        !cds_is_driver_in_bad_state() && !cds_is_driver_state_module_stop();
+}
+/* MISHARE_SHUTDOWN_END:platform */
