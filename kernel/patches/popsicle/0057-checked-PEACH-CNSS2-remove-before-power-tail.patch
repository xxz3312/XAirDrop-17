+/* Private PEACH-only lifecycle. No new fields in cnss_wlan_driver and no
+ * global/retained guard pointer: guard storage is borrowed by the synchronous
+ * unkillable event, then threaded explicitly through shutdown/remove.
+ */
+int cnss_wlan_unregister_driver_checked_v1(struct cnss_wlan_driver *driver_ops,
+				   int (*remove_status)(struct device *dev))
+{
+	struct cnss_plat_data *plat_priv;
+	struct cnss_pci_data *pci_priv;
+	struct cnss_mishare_unregister_guard guard = { driver_ops, remove_status };
+	int ret;
+
+	if (!driver_ops || !remove_status)
+		return -EINVAL;
+	plat_priv = cnss_get_plat_priv_by_driver_ops(driver_ops);
+	if (!plat_priv)
+		return -ENODEV;
+	mutex_lock(&plat_priv->driver_ops_lock);
+	if (test_bit(CNSS_MISHARE_UNREGISTER_TERMINAL, &plat_priv->driver_state)) {
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	if (plat_priv->bus_type != CNSS_BUS_PCI ||
+	    plat_priv->device_id != PEACH_DEVICE_ID) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	pci_priv = plat_priv->bus_priv;
+	if (!pci_priv || pci_priv->driver_ops != driver_ops) {
+		ret = -ENOENT;
+		goto out;
+	}
+	set_bit(CNSS_MISHARE_UNREGISTER_TERMINAL, &plat_priv->driver_state);
+	ret = cnss_driver_event_post(plat_priv,
+				    CNSS_DRIVER_EVENT_UNREGISTER_DRIVER,
+				    CNSS_EVENT_SYNC_UNKILLABLE, &guard);
+out:
+	mutex_unlock(&plat_priv->driver_ops_lock);
+	return ret;
+}
+EXPORT_SYMBOL(cnss_wlan_unregister_driver_checked_v1);
+
+int cnss_pci_unregister_driver_checked_hdlr(struct cnss_pci_data *pci_priv,
+		struct cnss_mishare_unregister_guard *guard)
+{
+	struct cnss_plat_data *plat_priv;
+	unsigned long rejected;
+	int ret;
+
+	if (!pci_priv || !pci_priv->plat_priv || !pci_priv->pci_dev)
+		return -ENODEV;
+	plat_priv = pci_priv->plat_priv;
+	if (!guard || !guard->remove_status || !guard->ops ||
+	    guard->ops != pci_priv->driver_ops || !guard->ops->remove)
+		return -EINVAL;
+	if (pci_priv->device_id != PEACH_DEVICE_ID ||
+	    plat_priv->device_id != PEACH_DEVICE_ID ||
+	    plat_priv->bus_type != CNSS_BUS_PCI)
+		return -EOPNOTSUPP;
+	if (!test_bit(CNSS_MISHARE_UNREGISTER_TERMINAL, &plat_priv->driver_state))
+		return -EPERM;
+	if (!test_bit(CNSS_DRIVER_PROBED, &plat_priv->driver_state) ||
+	    !test_bit(CNSS_DRIVER_REGISTERED, &plat_priv->driver_state))
+		return -ENODEV;
+	rejected = BIT(CNSS_DRIVER_LOADING) | BIT(CNSS_DRIVER_UNLOADING) |
+		BIT(CNSS_DRIVER_RECOVERY) | BIT(CNSS_FW_BOOT_RECOVERY) |
+		BIT(CNSS_DEV_ERR_NOTIFY) | BIT(CNSS_IN_COLD_BOOT_CAL) |
+		BIT(CNSS_DRIVER_DEBUG) | BIT(CNSS_IN_REBOOT) |
+		BIT(CNSS_IN_PANIC) | BIT(CNSS_IN_SUSPEND_RESUME) |
+		BIT(CNSS_DRIVER_IDLE_SHUTDOWN) | BIT(CNSS_DRIVER_IDLE_RESTART) |
+		BIT(CNSS_SHUTDOWN_DEVICE) | BIT(CNSS_POWER_OFF) | BIT(CNSS_POWERING_ON);
+	if ((plat_priv->driver_state & rejected) ||
+	    plat_priv->pm_suspend_in_progress ||
+	    plat_priv->ramdump_info_v2.dump_data_valid ||
+	    plat_priv->xdump_helper.dumping_bt_over_wl || pci_priv->pci_link_down_ind)
+		return -EBUSY;
+	/* A fresh scope must have no prior completed or in-flight remove. */
+	ret = guard->remove_status(&pci_priv->pci_dev->dev);
+	if (ret != -ENODATA)
+		return ret ? ret : -EALREADY;
+	set_bit(CNSS_DRIVER_UNLOADING, &plat_priv->driver_state);
+	ret = cnss_qca6290_shutdown_internal(pci_priv, guard);
+	if (ret) {
+		/* Keep terminal even if a native power-tail operation failed after
+		 * successful remove. Already executed hardware steps are not undone.
+		 */
+		set_bit(CNSS_DRIVER_UNLOADING, &plat_priv->driver_state);
+		return ret;
+	}
+	pci_priv->driver_ops = NULL;
+	clear_bit(CNSS_DRIVER_REGISTERED, &plat_priv->driver_state);
+	clear_bit(CNSS_MISHARE_UNREGISTER_TERMINAL, &plat_priv->driver_state);
+	return 0;
+}
