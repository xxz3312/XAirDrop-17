+/* MISHARE_BEGIN:radio_wma */
+int mishare_ndi_radio_start_response(struct vdev_mlme_obj *m,
+                                    struct vdev_start_response *rsp)
+{
+ tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+ uint8_t id;
+ QDF_STATUS status;
+ if (!m || !m->vdev || !rsp || !wma || !wma->interfaces || !wma->wmi_handle ||
+     wma->psoc != wlan_vdev_get_psoc(m->vdev) || !m->ext_vdev_ptr)
+  return -EUCLEAN;
+ id = wlan_vdev_get_id(m->vdev);
+ if (id >= wma->max_bssid || rsp->vdev_id != id || rsp->status ||
+     rsp->resp_type != WMI_HOST_VDEV_START_RESP_EVENT ||
+     wma->interfaces[id].vdev != m->vdev ||
+     !wma_mishare_pas_ndi(m->vdev, m->mgmt.generic.type) ||
+     m->mgmt.generic.subtype || wlan_vdev_mlme_get_state(m->vdev) != WLAN_VDEV_S_START)
+  return -EUCLEAN;
+ status = wma_vdev_start_resp_handler(m, rsp);
+ return QDF_IS_STATUS_ERROR(status) ? -EUCLEAN : 0;
+}
+int mishare_ndi_radio_host_up(struct wlan_objmgr_vdev *vdev)
+{
+ tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+ struct vdev_mlme_obj *m;
+ int ret = mishare_ndi_start_plan_wma_check(vdev);
+ QDF_STATUS status;
+ if (ret)
+  return ret;
+ m = wlan_vdev_mlme_get_cmpt_obj(vdev);
+ if (!m || m->vdev != vdev || !m->ext_vdev_ptr ||
+     wlan_vdev_mlme_get_state(vdev) != WLAN_VDEV_S_UP)
+  return -EUCLEAN;
+ status = wma_mon_mlme_vdev_up_send(m, 0, NULL); /* NDI: no firmware UP */
+ if (QDF_IS_STATUS_ERROR(status))
+  return -EUCLEAN;
+ ret = mishare_ndi_radio_start_pm_release(vdev);
+ if (ret)
+  return ret;
+ qdf_atomic_set(&wma->interfaces[wlan_vdev_get_id(vdev)].bss_status,
+                WMA_BSS_STATUS_STARTED);
+ return 0;
+}
+int mishare_ndi_radio_mark_down(struct wlan_objmgr_vdev *vdev)
+{
+ tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+ uint8_t id;
+ if (!vdev || !wma || !wma->wmi_handle || !wma->interfaces ||
+     wma->psoc != wlan_vdev_get_psoc(vdev))
+  return -EUCLEAN;
+ id = wlan_vdev_get_id(vdev);
+ if (id >= wma->max_bssid || wma->interfaces[id].vdev != vdev ||
+     !wma_mishare_pas_ndi(vdev, wma->interfaces[id].type) ||
+     qdf_atomic_read(&wma->interfaces[id].bss_status) != WMA_BSS_STATUS_STARTED)
+  return -EUCLEAN;
+ qdf_atomic_set(&wma->interfaces[id].bss_status, WMA_BSS_STATUS_STOPPED);
+ return 0;
+}
+/* MISHARE_END:radio_wma */
