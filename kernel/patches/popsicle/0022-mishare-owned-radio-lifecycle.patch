+int mishare_ndi_radio_start_pm_release(struct wlan_objmgr_vdev *vdev)
+{
+ struct vdev_mlme_obj *m;
+ struct wlan_objmgr_psoc *psoc;
+ if (!vdev || wlan_vdev_mlme_get_opmode(vdev) != QDF_PASSTHRU_MODE)
+  return -EUCLEAN;
+ m = wlan_vdev_mlme_get_cmpt_obj(vdev);
+ psoc = wlan_vdev_get_psoc(vdev);
+ if (!m || m->vdev != vdev || !m->ext_vdev_ptr || !psoc ||
+     m->mgmt.generic.type != WLAN_VDEV_MLME_TYPE_NDI ||
+     m->mgmt.generic.subtype || wlan_vdev_mlme_get_state(vdev) != WLAN_VDEV_S_UP)
+  return -EUCLEAN;
+ target_if_wake_lock_timeout_release(psoc, START_WAKELOCK);
+ target_if_release_vdev_cmd_rt_lock(psoc, wlan_vdev_get_id(vdev));
+ return 0;
+}
