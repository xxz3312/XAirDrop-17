+/* MISHARE_BEGIN:wma_helpers */
+int mishare_ndi_wma_bind(struct wlan_objmgr_vdev *vdev)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wma_txrx_node *iface;
+	struct vdev_mlme_obj *m;
+	uint8_t id;
+
+	if (!wma || !vdev || wma->psoc != wlan_vdev_get_psoc(vdev))
+		return -EINVAL;
+	id = wlan_vdev_get_id(vdev);
+	if (id >= wma->max_bssid)
+		return -EINVAL;
+	m = wlan_vdev_mlme_get_cmpt_obj(vdev);
+	iface = &wma->interfaces[id];
+	if (!m || m->vdev != vdev || !m->ext_vdev_ptr || !wma_mishare_pas_ndi(vdev, m->mgmt.generic.type) ||
+	    m->mgmt.generic.subtype || iface->vdev || iface->peer_count ||
+	    iface->vdev_active || iface->del_staself_req || iface->is_del_sta_deferred)
+		return -EBUSY;
+	if (wlan_objmgr_vdev_try_get_ref(vdev, WLAN_LEGACY_WMA_ID) != QDF_STATUS_SUCCESS)
+		return -ENODEV;
+	iface->type = WMI_VDEV_TYPE_NDI;
+	iface->sub_type = 0;
+	iface->pause_bitmap = 0;
+	qdf_atomic_set(&iface->bss_status, WMA_BSS_STATUS_STOPPED);
+	iface->vdev = vdev;
+	iface->vdev_active = true; /* created slot, not START/UP or radio proof */
+	return 0;
+}
+
+int mishare_ndi_wma_unbind(struct wlan_objmgr_vdev *vdev)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wma_txrx_node *iface;
+	uint8_t id;
+
+	if (!wma || !vdev || wma->psoc != wlan_vdev_get_psoc(vdev))
+		return -EINVAL;
+	id = wlan_vdev_get_id(vdev);
+	if (id >= wma->max_bssid)
+		return -EINVAL;
+	iface = &wma->interfaces[id];
+	if (iface->vdev != vdev || !wma_mishare_pas_ndi(vdev, iface->type) ||
+	    iface->peer_count || iface->del_staself_req || iface->is_del_sta_deferred ||
+	    qdf_atomic_read(&iface->bss_status) != WMA_BSS_STATUS_STOPPED)
+		return -EBUSY;
+	iface->vdev = NULL;
+	iface->vdev_active = false;
+	iface->type = 0;
+	iface->sub_type = 0;
+	iface->pause_bitmap = 0;
+	/* DP detach belongs to the runtime owner, never generic wma_cleanup_vdev. */
+	wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_WMA_ID);
+	return 0;
+}
+
+int mishare_ndi_self_peer_create(struct wlan_objmgr_vdev *vdev, bool *attempted)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wlan_objmgr_peer *peer;
+	uint8_t id;
+	QDF_STATUS status;
+
+	if (!attempted)
+		return -EINVAL;
+	*attempted = false;
+	if (!wma || !vdev || wma->psoc != wlan_vdev_get_psoc(vdev))
+		return -EINVAL;
+	id = wlan_vdev_get_id(vdev);
+	if (id >= wma->max_bssid || wma->interfaces[id].vdev != vdev ||
+	    !wma_mishare_pas_ndi(vdev, wma->interfaces[id].type) ||
+	    wma->interfaces[id].peer_count)
+		return -EINVAL;
+	if (!wmi_service_enabled(wma->wmi_handle, wmi_service_nan_data) ||
+	    !wmi_service_enabled(wma->wmi_handle, wmi_service_sync_delete_cmds))
+		return -EOPNOTSUPP;
+	peer = wlan_objmgr_get_peer_by_mac(wma->psoc,
+					 wlan_vdev_mlme_get_macaddr(vdev), WLAN_LEGACY_WMA_ID);
+	if (peer) {
+		bool same_vdev = wlan_peer_get_vdev(peer) == vdev;
+
+		wlan_objmgr_peer_release_ref(peer, WLAN_LEGACY_WMA_ID);
+		/* Unknown pre-existing resources on this owner cannot be unwound
+		 * as an empty vdev; a foreign vdev's peer must remain untouched.
+		 */
+		return same_vdev ? -EUCLEAN : -EEXIST;
+	}
+	*attempted = true; /* a generic error cannot prove no peer command escaped */
+	status = wma_create_peer(wma, wlan_vdev_mlme_get_macaddr(vdev), NULL,
+				 WMI_PEER_TYPE_DEFAULT, id, NULL, false);
+	if (QDF_IS_STATUS_ERROR(status))
+		return qdf_status_to_os_return(status);
+	if (wma->interfaces[id].peer_count != 1)
+		return -EUCLEAN;
+	return 0;
+}
+
+int mishare_ndi_self_peer_delete(struct wlan_objmgr_vdev *vdev, void *owner)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wma_target_req *req;
+	uint8_t id, *mac;
+
+	if (!wma || !vdev || !owner || wma->psoc != wlan_vdev_get_psoc(vdev))
+		return -EINVAL;
+	id = wlan_vdev_get_id(vdev);
+	if (id >= wma->max_bssid || wma->interfaces[id].vdev != vdev ||
+	    !wma_mishare_pas_ndi(vdev, wma->interfaces[id].type) ||
+	    wma->interfaces[id].peer_count != 1 ||
+	    !wmi_service_enabled(wma->wmi_handle, wmi_service_sync_delete_cmds))
+		return -EINVAL;
+	mac = wlan_vdev_mlme_get_macaddr(vdev);
+	wma_acquire_wakelock(&wma->wmi_cmd_rsp_wake_lock, WMA_DELETE_STA_TIMEOUT);
+	req = wma_fill_hold_req(wma, id, WMA_DELETE_STA_REQ,
+			       WMA_MISHARE_SELF_PEER_DELETE_RSP, mac, owner,
+			       WMA_DELETE_STA_TIMEOUT);
+	if (!req) {
+		wma_release_wakelock(&wma->wmi_cmd_rsp_wake_lock);
+		return -ENOMEM;
+	}
+	/* Fully armed request precedes the wire call. On generic send failure
+	 * leave it to consume a late real reply or timeout exactly once; userdata
+	 * is a stable owner token, never an ordinary SME delete parameter.
+	 */
+	return qdf_status_to_os_return(wma_remove_peer(wma, mac, id, false));
+}
+/* MISHARE_END:wma_helpers */
