+/* MISHARE_BEGIN:legacy_helpers */
+int mishare_ndi_legacy_prepare(struct vdev_mlme_obj *m)
+{
+	QDF_STATUS status;
+
+	if (!m || !m->vdev || m->ext_vdev_ptr ||
+	    wlan_vdev_mlme_get_opmode(m->vdev) != QDF_PASSTHRU_MODE ||
+	    m->mgmt.generic.type != WLAN_VDEV_MLME_TYPE_NDI)
+		return qdf_status_to_os_return(QDF_STATUS_E_INVAL);
+	m->ext_vdev_ptr = qdf_mem_common_alloc(sizeof(struct mlme_legacy_priv));
+	if (!m->ext_vdev_ptr)
+		return qdf_status_to_os_return(QDF_STATUS_E_NOMEM);
+	qdf_mem_zero(m->ext_vdev_ptr, sizeof(struct mlme_legacy_priv));
+	status = mlme_init_rate_config(m);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto free_ext;
+	status = mlme_init_connect_chan_info_config(m);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto free_ext;
+	m->ext_vdev_ptr->wait_key_timer.vdev = m->vdev;
+	status = qdf_mc_timer_init(&m->ext_vdev_ptr->wait_key_timer.timer,
+				  QDF_TIMER_TYPE_SW,
+				  cm_wait_for_key_time_out_handler,
+				  &m->ext_vdev_ptr->wait_key_timer);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto free_ext;
+	status = qdf_wake_lock_create(&m->ext_vdev_ptr->bss_color_change_wakelock,
+				      "mishare_bss_color");
+	if (QDF_IS_STATUS_ERROR(status))
+		goto free_timer;
+	status = qdf_runtime_lock_init(&m->ext_vdev_ptr->bss_color_change_runtime_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto free_color_wake;
+	status = qdf_runtime_lock_init(&m->ext_vdev_ptr->disconnect_runtime_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto free_color_rt;
+	qdf_atomic_init(&m->ext_vdev_ptr->set_key_wakelock_counter);
+	status = qdf_wake_lock_create(&m->ext_vdev_ptr->peer_set_key_wakelock,
+				      "mishare_peer_key");
+	if (QDF_IS_STATUS_ERROR(status))
+		goto free_disconnect;
+	status = qdf_runtime_lock_init(&m->ext_vdev_ptr->peer_set_key_rt_wakelock);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto free_peer_wake;
+	/* PAS has no STA roam stats/FILS or CSR session. All optional pointers
+	 * are explicitly zeroed; native full legacy destruction handles them.
+	 * No NSS override, second CREATE, SME or WMI operation occurs here.
+	 */
+	return 0;
+free_peer_wake:
+	qdf_wake_lock_destroy(&m->ext_vdev_ptr->peer_set_key_wakelock);
+free_disconnect:
+	qdf_runtime_lock_deinit(&m->ext_vdev_ptr->disconnect_runtime_lock);
+free_color_rt:
+	qdf_runtime_lock_deinit(&m->ext_vdev_ptr->bss_color_change_runtime_lock);
+free_color_wake:
+	qdf_wake_lock_destroy(&m->ext_vdev_ptr->bss_color_change_wakelock);
+free_timer:
+	qdf_mc_timer_destroy(&m->ext_vdev_ptr->wait_key_timer.timer);
+free_ext:
+	qdf_mem_common_free(m->ext_vdev_ptr);
+	m->ext_vdev_ptr = NULL;
+	return qdf_status_to_os_return(status);
+}
+
+int mishare_ndi_legacy_release(struct vdev_mlme_obj *m)
+{
+	if (!m || !m->vdev || !m->ext_vdev_ptr ||
+	    wlan_vdev_mlme_get_opmode(m->vdev) != QDF_PASSTHRU_MODE ||
+	    m->mgmt.generic.type != WLAN_VDEV_MLME_TYPE_NDI)
+		return qdf_status_to_os_return(QDF_STATUS_E_INVAL);
+	mlme_ext_handler_destroy(m);
+	return 0;
+}
