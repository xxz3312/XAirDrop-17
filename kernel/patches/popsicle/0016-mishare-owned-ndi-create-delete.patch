+
+	if (!result->stats_owned)
+		return 0;
+	psoc = wlan_vdev_get_psoc(mlme->vdev);
+	if (!psoc || !wlan_psoc_get_dp_handle(psoc))
+		return qdf_status_to_os_return(QDF_STATUS_E_FAILURE);
+	vdev_mgr_reset_vdev_stats_id(mlme->vdev, result->stats_id);
+	result->stats_owned = false;
+	return 0;
