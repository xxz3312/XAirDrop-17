+	if (!vdev || !param || !result ||
+	    wlan_vdev_mlme_get_opmode(vdev) != QDF_PASSTHRU_MODE ||
+	    param->type != WMI_VDEV_TYPE_NDI || param->subtype ||
+	    param->vdev_id != wlan_vdev_get_id(vdev))
+		return qdf_status_to_os_return(QDF_STATUS_E_INVAL);
+	psoc = wlan_vdev_get_psoc(vdev);
+	wmi = target_if_vdev_mgr_wmi_handle_get(vdev);
