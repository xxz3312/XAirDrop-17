+	    mlme->mgmt.generic.type != WLAN_VDEV_MLME_TYPE_NDI ||
+	    mlme->mgmt.generic.subtype || mlme->ext_vdev_ptr)
+		return qdf_status_to_os_return(QDF_STATUS_E_INVAL);
