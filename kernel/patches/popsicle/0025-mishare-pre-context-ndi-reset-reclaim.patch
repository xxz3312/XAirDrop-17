+/* MISHARE_RECOVERY_BEGIN:cds_helper */
+#include "wmi_unified_api.h"
+static void mishare_cds_recovery_window(tp_wma_handle wma,
+                                      struct hif_opaque_softc *hif)
+{
+ if (!wma || !wma->psoc || !hif || !gp_cds_context ||
+     !gp_cds_context->htc_ctx || !cds_is_driver_recovering() ||
+     !mishare_runtime_recovery_candidates(wma->psoc) ||
+     wmi_validate_handle(wma->wmi_handle) || !wmi_is_blocked(wma->wmi_handle) ||
+     hif_get_target_status(hif) != TARGET_STATUS_RESET)
+  return;
+ /* HTC/IRQ/RX stop preceded this call. Drain independent WMI work queues
+  * while timer/DP/MLME parents still exist. No default-owner path changes. */
+ if (QDF_IS_STATUS_SUCCESS(wma_wmi_work_close()))
+  mishare_runtime_recovery_open(wma->psoc);
+}
