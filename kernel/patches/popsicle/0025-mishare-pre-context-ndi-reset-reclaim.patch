+/* MISHARE_RECOVERY_BEGIN:timer */
+#include "wlan_hdd_mishare_ndi.h"
+#include <wlan_vdev_mlme.h>
+#include <linux/errno.h>
+int mishare_ndi_recovery_timer_deinit(struct wlan_objmgr_vdev *vdev)
+{
+ struct wlan_objmgr_psoc *psoc;
+ struct wlan_lmac_if_mlme_rx_ops *rx;
+ struct vdev_response_timer *r;
+ struct vdev_mlme_obj *m;
+ uint8_t id;
+ if (!vdev || wlan_vdev_mlme_get_opmode(vdev) != QDF_PASSTHRU_MODE)
+  return -EUCLEAN;
+ psoc = wlan_vdev_get_psoc(vdev);
+ id = wlan_vdev_get_id(vdev);
+ m = wlan_vdev_mlme_get_cmpt_obj(vdev);
+ if (!psoc || id >= WLAN_UMAC_PSOC_MAX_VDEVS || !m || m->vdev != vdev ||
+     m->ext_vdev_ptr || m->mgmt.generic.type != WLAN_VDEV_MLME_TYPE_NDI ||
+     m->mgmt.generic.subtype || wlan_vdev_mlme_get_state(vdev) != WLAN_VDEV_S_INIT)
+  return -EUCLEAN;
+ rx = target_if_vdev_mgr_get_rx_ops(psoc);
+ if (!rx || !rx->psoc_get_vdev_response_timer_info)
+  return -EUCLEAN;
+ r = rx->psoc_get_vdev_response_timer_info(psoc, id);
+ if (!r || r->psoc != psoc || r->vdev_id != id ||
+     qdf_atomic_read(&r->rsp_timer_inuse) != 1 || r->rsp_status ||
+     r->rt_lock.is_lock_acquired)
+  return -EUCLEAN;
+ /* Even an inactive timer is synchronously excluded before native free. */
+ qdf_timer_sync_cancel(&r->rsp_timer);
+ if (r->psoc != psoc || r->vdev_id != id || r->rsp_status ||
+     qdf_atomic_read(&r->rsp_timer_inuse) != 1 || r->rt_lock.is_lock_acquired)
+  return -EUCLEAN;
+ target_if_psoc_vdev_rsp_timer_deinit(psoc, id);
+ if (r->psoc || qdf_atomic_read(&r->rsp_timer_inuse) || r->rt_lock.is_lock_acquired)
+  return -EUCLEAN;
+ return 0;
+}
+/* MISHARE_RECOVERY_END:timer */
