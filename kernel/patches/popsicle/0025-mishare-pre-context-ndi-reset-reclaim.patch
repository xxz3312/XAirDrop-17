+/* MISHARE_RECOVERY_BEGIN:dp_detach */
+int mishare_ndi_recovery_dp_detach(struct wlan_objmgr_vdev *vdev,
+                                   unsigned long dp_cookie,
+                                   void (*callback)(void *), void *context)
+{
+ struct wlan_objmgr_psoc *psoc;
+ struct vdev_mlme_obj *m;
+ ol_txrx_soc_handle soc;
+ if (!vdev || !dp_cookie || !callback || !context ||
+     wlan_vdev_mlme_get_opmode(vdev) != QDF_PASSTHRU_MODE)
+  return qdf_status_to_os_return(QDF_STATUS_E_INVAL);
+ psoc = wlan_vdev_get_psoc(vdev);
+ m = wlan_vdev_mlme_get_cmpt_obj(vdev);
+ if (!psoc || !m || m->vdev != vdev || m->ext_vdev_ptr ||
+     m->mgmt.generic.type != WLAN_VDEV_MLME_TYPE_NDI || m->mgmt.generic.subtype ||
+     wlan_vdev_mlme_get_state(vdev) != WLAN_VDEV_S_INIT)
+  return qdf_status_to_os_return(QDF_STATUS_E_INVAL);
+ soc = wlan_psoc_get_dp_handle(psoc);
+ if (!soc || (unsigned long)soc != dp_cookie)
+  return qdf_status_to_os_return(QDF_STATUS_E_FAILURE);
+ return mishare_ndi_native_dp_detach(vdev, callback, context);
+}
+/* MISHARE_RECOVERY_END:dp_detach */
