+/* MISHARE_SSR_STOP_BEGIN:remove_prepare */
+int hdd_mishare_remove_prepare(struct device *dev)
+{
+	struct hdd_context *hdd_ctx = cds_get_context(QDF_MODULE_ID_HDD);
+	int ret;
+
+	if (!dev || !hdd_ctx)
+		return -EINVAL;
+	if (hdd_ctx->parent_dev != dev)
+		return -EUCLEAN;
+	/* PLD must call before unregistering the device's sync lookup. */
+	osif_psoc_sync_assert_trans_protected(dev);
+	if (mishare_ssr_stop_blocked)
+		return -EBUSY;
+	ret = hdd_mishare_module_remove_ready(hdd_ctx);
+	if (ret)
+		return ret;
+	ret = mishare_wonder_host_stop_ready_locked(hdd_ctx);
+	if (ret)
+		return ret;
+	/* Detach failure retains the managed owner and must retain its HDD. */
+	return mishare_wonder_backend_unregister(hdd_ctx);
+}
+/* MISHARE_SSR_STOP_END:remove_prepare */
