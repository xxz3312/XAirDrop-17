@@ -830,6 +831,11 @@
 	hdd_set_sar_init_index(hdd_ctx);
 	hdd_soc_load_unlock(dev);
 
+	/* Optional bridge failure leaves normal WLAN startup intact. */
+	errno = mishare_wonder_backend_register(hdd_ctx);
+	if (errno)
+		hdd_err("MiShare Wonder table registration failed: %d", errno);
+
 	return 0;
 
