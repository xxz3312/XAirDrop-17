--- a/qcacld-3.0/core/hdd/src/wlan_hdd_driver_ops.c
+++ b/qcacld-3.0/core/hdd/src/wlan_hdd_driver_ops.c
@@ -29,6 +29,7 @@
 #include "epping_main.h"
 #include "osif_sync.h"
