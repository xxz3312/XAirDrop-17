+/* MISHARE_SSR_STOP_BEGIN:power_complete_helpers */
+static void hdd_mishare_shutdown_complete(struct hdd_context *hdd_ctx)
+{
+	hdd_lpass_notify_stop(hdd_ctx);
+
+	qdf_set_smmu_fault_state(false);
+	hdd_info("WLAN driver shutdown complete");
+}
+
+int hdd_mishare_resume_shutdown(struct hdd_context *hdd_ctx)
+{
+	int ret;
+
+	if (!hdd_ctx)
+		return -EINVAL;
+	ret = hdd_mishare_resume_stop_modules(hdd_ctx);
+	if (ret)
+		return ret;
+	hdd_mishare_shutdown_complete(hdd_ctx);
+	return 0;
+}
+/* MISHARE_SSR_STOP_END:power_complete_helpers */
